// Creator Compiler, native shell (Exact spike). The Video board and Research, read live from the studio's
// local service; a card dragged to another lane is saved through the same move API the web board uses, and a
// card opens the existing editor in a web view (an `iframe`: WKWebView on macOS).
use EmptyState from "exact:content"

routes nav
  tab videos "/"
    video "/video/:id"
  tab research "/research"

shape Studio
  api: string
  slug: string
  channel: string
  handle: string

shape Card
  id: string
  title: string
  stage: string
  number: string
  detail: string

shape Tile
  id: string
  title: string
  detail: string
  url: string
  symbol: string

shape Reply
  ok: bool
  error: string

fn stageLabel(s: string): string = s == "ideas" ? "Ideas" : s == "planning" ? "Planning" : s == "recording" ? "Recording" : s == "editing" ? "Editing" : s == "publishing" ? "Publishing" : "Published"
fn titleOf(cards: Card[], id: string): string = match first(cards.filter(c => c.id == id)) { case some(c) => c.title, case none => "Video" }
fn cardLine(c: Card): string = c.detail == "" ? c.number : c.number == "" ? c.detail : `${c.number} · ${c.detail}`
fn editorUrl(api: string, id: string): string = `${api}/#/video/${encodeURIComponent(id)}`

component App
  resource studio = loadStudio() as shape Studio else empty()
  resource videos = loadVideos(studio.api, studio.slug) when studio.slug != "" as shape Card[] else empty()
  resource research = loadResearch(studio.api, studio.slug) when studio.slug != "" as shape Tile[] else empty()
  mutation moved as shape Reply queue refreshes videos
  state target = ""
  derive moveError = match moved { case some(r) => r.error, case none => "" }
  derive stages = ["ideas", "planning", "recording", "editing", "publishing", "published"]
  derive down = failed(studio) and not current(studio)
  derive noChannel = current(studio) and studio.slug == ""

  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action highlight(stage: string, active: bool)
    target = active ? stage : (target == stage ? "" : target)
  action dropCard(stage: string, item: string, before: option<string>)
    let at = match before { case some(k) => k, case none => "" }
    send moved = moveVideo(studio.api, studio.slug, item, stage, at)
  // A Research link or the editor's page, in the person's browser.
  action openLink(url: string)
    openURL(url)

  view
    main navigationKey=`${top(nav).id}`
      navigate=follow
      testId="app"
      width="100%"
      height="100%"
      display="flex"
      flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              // The board is one wide screen, not a list beside a detail: a card pushes the editor over it.
              column navigationKey=`${e.id}`
                navigationScroll=`content-${e.id}`
                navigationSplit="none"
                position="absolute"
                inset=0
                display="flex"
                flex-direction="column"
                header display="flex" align-items="center" gap=8 padding="8px 16px"
                  text (e.name == "videos" ? "Videos" : e.name == "research" ? "Research" : titleOf(videos, e.params.id))
                    role="heading"
                    aria-level=(e.name == "video" ? 2 : 1)
                    flex=1
                    testId=`title-${e.name}`
                  if e.name == "video"
                    button press=openLink(editorUrl(studio.api, e.params.id))
                      aria-label="Open in browser"
                      testId="open-browser"
                      image "symbol:share"
                  else if studio.channel != ""
                    text studio.channel testId=`channel-${e.name}`
                if down
                  column flex=1 min-height=0 display="flex" testId=`down-${e.name}`
                    EmptyState(
                      symbol="symbol:alert",
                      title="Creator Compiler isn’t running",
                      message="Start the studio (npm run dev, or open the app), then reopen this window."
                    )
                else if noChannel
                  EmptyState(
                    symbol="symbol:people",
                    title="No channel yet",
                    message="Add a channel in Creator Compiler; its board shows here."
                  )
                else if e.name == "videos"
                  column flex=1 min-height=0 display="flex" flex-direction="column"
                    if moveError != ""
                      text moveError role="alert"
                        color="-exact-system-red"
                        padding="0 16px 8px"
                        testId="move-error"
                    scroll id=`content-${e.id}`
                      testId="board"
                      overflow-x="auto"
                      overflow-y="hidden"
                      flex=1
                      min-height=0
                      row gap=12
                        padding=16
                        height="100%"
                        box-sizing="border-box"
                        align-items="stretch"
                        for s in stages key=s
                          column testId=`lane-${s}`
                            width="16.5rem"
                            flex-shrink=0
                            height="100%"
                            display="flex"
                            flex-direction="column"
                            background-color="lane.ground"
                            border-radius=12
                            border-width=2
                            border-style="solid"
                            border-color=(target == s ? "brand.fill" : "transparent")
                            box-sizing="border-box"
                            row padding="12px 14px 8px" gap=8 align-items="baseline" flex-shrink=0
                              text stageLabel(s) font-weight=600 flex=1 testId=`head-${s}`
                              text `${videos.filter(c => c.stage == s).length}` color="-exact-secondary-label"
                                font-variant-numeric="tabular-nums"
                                testId=`count-${s}`
                            list id=`lane-list-${s}`
                              testId=`list-${s}`
                              virtualized=true
                              appearance="none"
                              reorderGroup="videos"
                              reorderdrop=dropCard(s)
                              reordertargetchange=highlight(s)
                              estimated-item-height=76
                              flex=1
                              min-height=76
                              overflow-x="hidden"
                              for c in videos.filter(v => v.stage == s) key=c.id
                                row padding="0 8px 8px" box-sizing="border-box" testId=`row-${c.id}`
                                  row flex=1
                                    min-width=0
                                    gap=6
                                    align-items="center"
                                    padding="10px 10px 10px 4px"
                                    background-color="-exact-background"
                                    border-radius=10
                                    box reorderFor=`lane-list-${s}`
                                      touch-action="none"
                                      aria-label=`Move ${c.title}`
                                      testId=`grip-${c.id}`
                                      padding=4
                                      cursor="grab"
                                      image "symbol:reorder" color="-exact-tertiary-label"
                                        aria-hidden=true
                                    link href=path("video", c.id)
                                      flex=1
                                      min-width=0
                                      testId=`card-${c.id}`
                                      column gap=3 min-width=0
                                        text c.title font-weight=500 color="-exact-label"
                                        if cardLine(c) != ""
                                          text cardLine(c) font="-exact-footnote"
                                            color="-exact-secondary-label"
                else if e.name == "research"
                  if research.length == 0 and current(research)
                    EmptyState(
                      symbol="symbol:bookmark",
                      title="Nothing in Research",
                      message="Cards you save to Research in Creator Compiler show here."
                    )
                  else
                    list id=`content-${e.id}`
                      appearance="auto"
                      listStyle="inset-grouped"
                      flex=1
                      min-height=0
                      testId="research"
                      section
                        for r in research key=r.id
                          if r.url != ""
                            button press=openLink(r.url)
                              testId=`tile-${r.id}`
                              display="flex"
                              align-items="center"
                              gap=12
                              image r.symbol color="brand.fill" aria-hidden=true
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text r.title
                                text r.detail font="-exact-subheadline"
                                  color="-exact-secondary-label"
                          else
                            row testId=`tile-${r.id}`
                              image r.symbol color="brand.fill" aria-hidden=true
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text r.title
                                text r.detail font="-exact-subheadline"
                                  color="-exact-secondary-label"
                else
                  iframe editorUrl(studio.api, e.params.id) id="editor"
                    partition="persist:editor"
                    title="Creator Compiler editor"
                    flex=1
                    min-height=0
                    width="100%"
                    border="none"
                    testId="editor"
      row role="tablist" testId="tabs"
        button role="tab"
          aria-controls="panel-videos"
          aria-selected=(nav.tab == "videos")
          press=pick("videos")
          testId="tab-videos"
          flex=1
          image "symbol:list"
          text "Videos"
        button role="tab"
          aria-controls="panel-research"
          aria-selected=(nav.tab == "research")
          press=pick("research")
          testId="tab-research"
          flex=1
          image "symbol:bookmark"
          text "Research"
