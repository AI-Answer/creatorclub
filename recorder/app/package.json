{
  "name": "creator-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your local studio for writing, recording, and editing videos",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts src/*.test.ts scripts/*.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:app": "node scripts/dev-app.mjs --open",
    "mcp": "tsx server/mcp.ts",
    "build:server": "node scripts/bundle-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "package": "node scripts/package.mjs",
    "runtime:desktop": "node scripts/prepare-desktop-runtime.mjs",
    "package:desktop": "electron-builder --config electron-builder.cjs --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@resvg/resvg-js": "2.6.2",
    "express": "^5.0.0",
    "iconoir-react": "^7.11.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "mutative": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "^20.3.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.0.0",
    "electron": "^44.7.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "5.3.0",
    "happy-dom": "^21.0.1",
    "tsx": "^4.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "main": "desktop/main.cjs",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "ffmpeg-static@5.3.0": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "@ffprobe-installer/win32-x64@5.1.0": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "Creator Compiler",
  "author": "Samin Yasar",
  "license": "MIT"
}
